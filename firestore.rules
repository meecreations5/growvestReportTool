rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return hasUserProfile() && userDoc().data.status == 'active';
    }

    function role() {
      return userDoc().data.role;
    }

    function isSuperAdmin() {
      return activeUser() && role() == 'super_admin';
    }

    function isAdmin() {
      return activeUser() && (role() == 'super_admin' || role() == 'admin');
    }

    function isAdvisor() {
      return activeUser() && role() == 'advisor';
    }

    function isStaff() {
      return activeUser()
        && role() in ['super_admin', 'admin', 'advisor'];
    }

    function isInvestor() {
      return activeUser()
        && role() == 'investor'
        && userDoc().data.portalEnabled != false;
    }


    function invitationForCurrentEmail() {
      return get(/databases/$(database)/documents/staffInvitations/$(request.auth.token.email));
    }

    function hasPendingStaffInvitation() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/staffInvitations/$(request.auth.token.email))
        && invitationForCurrentEmail().data.status == 'pending';
    }

    function investorAliasForCurrentEmail() {
      return get(/databases/$(database)/documents/investorLoginAliases/$(request.auth.token.email));
    }

    function hasActiveInvestorAlias() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/investorLoginAliases/$(request.auth.token.email))
        && investorAliasForCurrentEmail().data.status == 'active'
        && investorAliasForCurrentEmail().data.portalEnabled != false;
    }

    function ownsAdvisorRecord(data) {
      // Collection/list queries must be provable from fields constrained by the
      // query itself. Persisted Advisor ownership fields remain the read authority
      // so existing advisorUid/assignedAdvisorUid queries stay rule-compatible.
      // Historical createdByUid is intentionally NOT a read authority.
      return isAdvisor() && (
        data.get('assignedAdvisorUid', null) == request.auth.uid
        || data.get('advisorUid', null) == request.auth.uid
      );
    }

    function investorOwnsRecord(data) {
      return isInvestor() && (
        data.investorPortalUid == request.auth.uid
        || data.portalUid == request.auth.uid
        || (
          userDoc().data.investorId != null
          && data.investorId == userDoc().data.investorId
        )
      );
    }

    function preservesAdvisorScope() {
      return request.resource.data.get('advisorUid', null) == resource.data.get('advisorUid', null)
        && request.resource.data.get('assignedAdvisorUid', null) == resource.data.get('assignedAdvisorUid', null)
        && request.resource.data.get('investorId', null) == resource.data.get('investorId', null)
        && request.resource.data.get('leadId', null) == resource.data.get('leadId', null)
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null);
    }

    function advisorOwnsInvestorAfter(investorId) {
      // getAfter() also recognises a linked Investor created in the same atomic
      // transaction/batch, while still returning current data for normal writes.
      return isAdvisor()
        && investorId is string
        && (
          getAfter(/databases/$(database)/documents/investors/$(investorId)).data.assignedAdvisorUid == request.auth.uid
          || getAfter(/databases/$(database)/documents/investors/$(investorId)).data.advisorUid == request.auth.uid
        );
    }

    function advisorOwnsLeadAfter(leadId) {
      // Lead creation and its audit record can be committed in one batch.
      return isAdvisor()
        && leadId is string
        && getAfter(/databases/$(database)/documents/leads/$(leadId)).data.assignedAdvisorUid == request.auth.uid;
    }

    function advisorCanReferenceScope(data) {
      return isAdvisor()
        && (
          data.get('investorId', '') == ''
          || advisorOwnsInvestorAfter(data.get('investorId', ''))
        )
        && (
          data.get('leadId', '') == ''
          || advisorOwnsLeadAfter(data.get('leadId', ''))
        );
    }

    function isActiveStaffUid(uid) {
      return uid is string
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'active'
        && get(/databases/$(database)/documents/users/$(uid)).data.role in ['super_admin', 'admin', 'advisor'];
    }

    function advisorCanCreateNotification(data) {
      return isAdvisor()
        && data.createdByUid == request.auth.uid
        && (
          data.recipientUid == request.auth.uid
          || isActiveStaffUid(data.recipientUid)
          || (
            advisorOwnsInvestorAfter(data.investorId)
            && (
              data.recipientUid == get(/databases/$(database)/documents/investors/$(data.investorId)).data.portalUid
              || data.recipientUid == get(/databases/$(database)/documents/investors/$(data.investorId)).data.investorPortalUid
            )
          )
        );
    }

    function preservesInvestorSecurityFields() {
      return request.resource.data.get('clientCode', null) == resource.data.get('clientCode', null)
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && request.resource.data.get('portalUid', null) == resource.data.get('portalUid', null)
        && request.resource.data.get('investorPortalUid', null) == resource.data.get('investorPortalUid', null)
        && request.resource.data.get('portalEnabled', false) == resource.data.get('portalEnabled', false)
        && request.resource.data.get('panNumber', '') == resource.data.get('panNumber', '')
        && request.resource.data.get('panNormalized', '') == resource.data.get('panNormalized', '')
        && request.resource.data.get('aadhaarConfigured', false) == resource.data.get('aadhaarConfigured', false)
        && request.resource.data.get('aadhaarLast4', '') == resource.data.get('aadhaarLast4', '')
        && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSuperAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && hasPendingStaffInvitation()
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == invitationForCurrentEmail().data.role
          && request.resource.data.get('advisorProfileEnabled', false) == invitationForCurrentEmail().data.get('advisorProfileEnabled', false)
          && request.resource.data.get('advisorCode', '') == invitationForCurrentEmail().data.get('advisorCode', '')
          && request.resource.data.status == 'active'
          && request.resource.data.authMethod == 'microsoft'
        )
        || (
          signedIn()
          && request.auth.uid == uid
          && hasActiveInvestorAlias()
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'investor'
          && request.resource.data.status == 'active'
          && request.resource.data.portalEnabled == true
          && request.resource.data.investorId == investorAliasForCurrentEmail().data.investorId
          && request.resource.data.authMethod == 'google'
        );

      allow delete: if isSuperAdmin();

      allow update: if isSuperAdmin()
        || (
          isAdmin()
          && resource.data.role in ['super_admin', 'admin', 'advisor']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['emailSignatureDraft', 'emailSignatureMeta', 'updatedAt', 'updatedByUid', 'updatedByName'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        )
        || (
          isAdmin()
          && request.auth.uid != uid
          && (role() == 'super_admin' || resource.data.role != 'super_admin')
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['permissionOverrides', 'updatedAt', 'updatedByUid', 'updatedByName'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        )
        || (
          request.auth.uid == uid
          && activeUser()
          && role() in ['super_admin', 'admin', 'advisor']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fullName', 'photoURL', 'lastLoginAt', 'emailSignatureDraft', 'emailSignatureMeta', 'updatedAt', 'updatedByUid', 'updatedByName'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        )
        || (
          request.auth.uid == uid
          && isInvestor()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fullName', 'photoURL', 'lastLoginAt', 'mustChangePassword', 'authMethods', 'authEmail', 'googleEmail', 'passwordChangedAt', 'updatedAt'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.get('investorId', null) == resource.data.get('investorId', null)
        );

      match /signatureVersions/{versionId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if isSuperAdmin();
        allow update, delete: if false;
      }
    }

    match /staffInvitations/{email} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.token.email == email);

      allow create, delete: if isSuperAdmin();

      allow update: if isSuperAdmin()
        || (
          signedIn()
          && request.auth.token.email == email
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'linkedUid', 'linkedAt', 'updatedAt'])
          && request.resource.data.status == 'linked'
          && request.resource.data.linkedUid == request.auth.uid
        );
    }

    match /usernames/{username} {
      allow read, write: if isAdmin();
    }

    match /investorLoginAliases/{email} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.token.email != null && request.auth.token.email == email);
      allow create, update, delete: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, write: if (counterId == 'advisors' && isSuperAdmin())
        || (counterId != 'advisors' && isStaff());
    }

    match /leads/{leadId} {
      allow create: if isStaff()
        && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (
          request.resource.data.assignedAdvisorUid == request.auth.uid
          && advisorCanReferenceScope(request.resource.data)
        ));

      allow read: if isAdmin() || ownsAdvisorRecord(resource.data);

      allow update: if isAdmin() || (
        ownsAdvisorRecord(resource.data)
        && preservesAdvisorScope()
      );

      allow delete: if isSuperAdmin();
    }

    match /leadFollowUps/{followUpId} {
      allow create: if isStaff()
        && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (
          request.resource.data.assignedAdvisorUid == request.auth.uid
          && advisorCanReferenceScope(request.resource.data)
        ));

      allow read: if isAdmin() || ownsAdvisorRecord(resource.data);
      allow update: if isAdmin() || (ownsAdvisorRecord(resource.data) && preservesAdvisorScope());
      allow delete: if isSuperAdmin();
    }

    match /activityLogs/{activityId} {
      allow create: if isStaff()
        && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (
          request.resource.data.advisorUid == request.auth.uid
          && advisorCanReferenceScope(request.resource.data)
        ));

      allow read: if isAdmin() || ownsAdvisorRecord(resource.data);
      allow update, delete: if isSuperAdmin();
    }


    match /clientAssessments/{assessmentId} {
      allow create: if isStaff()
        && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (
          request.resource.data.assignedAdvisorUid == request.auth.uid
          && advisorCanReferenceScope(request.resource.data)
        ));

      allow read: if isAdmin() || ownsAdvisorRecord(resource.data);
      allow update: if isAdmin() || (
        ownsAdvisorRecord(resource.data)
        && preservesAdvisorScope()
        && request.resource.data.get('leadId', null) == resource.data.get('leadId', null)
      );
      allow delete: if isSuperAdmin();
    }

    match /assessmentVersions/{versionId} {
      allow create: if isStaff()
        && request.resource.data.savedByUid == request.auth.uid
        && (isAdmin() || (
          request.resource.data.assignedAdvisorUid == request.auth.uid
          && advisorCanReferenceScope(request.resource.data)
        ));

      allow read: if isAdmin() || ownsAdvisorRecord(resource.data);
      allow update, delete: if isSuperAdmin();
    }

    match /investors/{investorId} {
      allow create: if isStaff()
        && request.resource.data.createdByUid == request.auth.uid
        && (
          isAdmin()
          || request.resource.data.get('assignedAdvisorUid', null) == request.auth.uid
          || request.resource.data.get('advisorUid', null) == request.auth.uid
        );

      allow read: if isAdmin()
        || ownsAdvisorRecord(resource.data)
        || (
          isInvestor()
          && (
            request.auth.uid == resource.data.portalUid
            || userDoc().data.investorId == investorId
          )
        );

      allow update: if isAdmin() || (
        ownsAdvisorRecord(resource.data)
        && preservesAdvisorScope()
        && preservesInvestorSecurityFields()
      );
      allow delete: if isSuperAdmin();
    }



    match /meetings/{meetingId} {
      allow create: if isStaff()
        && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (
          request.resource.data.advisorUid == request.auth.uid
          && advisorCanReferenceScope(request.resource.data)
        ));

      allow read: if isAdmin()
        || ownsAdvisorRecord(resource.data)
        || (
          investorOwnsRecord(resource.data)
          && resource.data.investorVisible == true
        );

      allow update: if isAdmin() || (
        ownsAdvisorRecord(resource.data)
        && preservesAdvisorScope()
      );

      allow delete: if isSuperAdmin();
    }

    match /followUps/{followUpId} {
      allow create: if isStaff()
        && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (
          request.resource.data.advisorUid == request.auth.uid
          && advisorCanReferenceScope(request.resource.data)
        ));
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data);
      allow update: if isAdmin() || (ownsAdvisorRecord(resource.data) && preservesAdvisorScope());
      allow delete: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      // Admins may create operational notifications. Advisors can notify
      // themselves, active staff, or the portal account of an Investor they
      // currently service. This prevents arbitrary cross-Investor messaging.
      allow create: if (isAdmin() && request.resource.data.createdByUid == request.auth.uid)
        || advisorCanCreateNotification(request.resource.data);

      // Notifications are private to the explicit recipient UID. InvestorId is
      // context/metadata only and must never be an alternative read authority.
      allow read: if activeUser() && resource.data.recipientUid == request.auth.uid;
      allow update: if activeUser()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'readAt']);
      allow delete: if isSuperAdmin();
    }

    match /communicationLogs/{logId} {
      allow read: if isAdmin()
        || (isAdvisor() && resource.data.advisorUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /notificationPreferences/{preferenceId} {
      allow read: if activeUser()
        && (preferenceId == request.auth.uid || isAdmin());
      allow create, update: if activeUser()
        && (preferenceId == request.auth.uid || isAdmin());
      allow delete: if isSuperAdmin();
    }

    // FCM registration tokens are written only by authenticated server routes.
    // They are intentionally unavailable to browser clients and other users.
    match /pushSubscriptions/{subscriptionId} {
      allow read, create, update, delete: if false;
    }

    match /meetingMinutes/{momId} {
      allow create: if isStaff()
        && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (
          request.resource.data.advisorUid == request.auth.uid
          && advisorCanReferenceScope(request.resource.data)
        ));

      allow read: if isAdmin()
        || ownsAdvisorRecord(resource.data)
        || (
          investorOwnsRecord(resource.data)
          && resource.data.investorVisible == true
        );

      allow update: if isAdmin() || (
        ownsAdvisorRecord(resource.data)
        && request.resource.data.get('advisorUid', null) == resource.data.get('advisorUid', null)
        && request.resource.data.get('assignedAdvisorUid', null) == resource.data.get('assignedAdvisorUid', null)
        && request.resource.data.get('investorId', null) == resource.data.get('investorId', null)
        && request.resource.data.get('investorPortalUid', null) == resource.data.get('investorPortalUid', null)
        && request.resource.data.get('leadId', null) == resource.data.get('leadId', null)
        && request.resource.data.get('meetingId', null) == resource.data.get('meetingId', null)
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && request.resource.data.get('momCode', null) == resource.data.get('momCode', null)
      );
      allow delete: if isSuperAdmin();
    }

    match /investorActions/{actionId} {
      allow read: if isAdmin()
        || ownsAdvisorRecord(resource.data)
        || (investorOwnsRecord(resource.data) && resource.data.investorVisible == true);
      // Investor action writes go through authenticated server API routes so
      // workflow/audit fields cannot be forged from a browser client.
      allow create, update, delete: if false;
    }

    match /investorActionEvents/{eventId} {
      allow read: if isAdmin()
        || ownsAdvisorRecord(resource.data)
        || (investorOwnsRecord(resource.data) && resource.data.investorVisible == true);
      allow create, update, delete: if false;
    }

    match /monthlyReports/{reportId} {
      allow create: if isStaff()
        && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (
          request.resource.data.advisorUid == request.auth.uid
          && advisorCanReferenceScope(request.resource.data)
        ));

      allow read: if isAdmin()
        || ownsAdvisorRecord(resource.data)
        || (
          investorOwnsRecord(resource.data)
          && resource.data.investorVisible == true
          && resource.data.status == 'completed'
        );

      allow update: if isAdmin() || (
        ownsAdvisorRecord(resource.data)
        && preservesAdvisorScope()
        && request.resource.data.get('investorPortalUid', null) == resource.data.get('investorPortalUid', null)
        && request.resource.data.get('reportCode', null) == resource.data.get('reportCode', null)
      );
      // Monthly Report deletion is server-managed so published-version/PDF
      // cleanup, permission checks, Investor Portal removal and audit logging
      // always happen as one controlled workflow.
      allow delete: if false;
    }


    match /reportVersions/{versionId} {
      allow read: if isAdmin()
        || ownsAdvisorRecord(resource.data)
        || (
          isInvestor()
          && resource.data.investorVisible == true
          && resource.data.status == 'completed'
          && resource.data.investorId == userDoc().data.investorId
          && get(/databases/$(database)/documents/monthlyReports/$(resource.data.reportId)).data.activePublishedVersionId == versionId
        );
      allow create, update, delete: if false;
    }

    match /reportAcknowledgements/{acknowledgementId} {
      allow read: if isAdmin()
        || (isInvestor() && resource.data.investorUid == request.auth.uid)
        || (isAdvisor() && resource.data.advisorUid == request.auth.uid);
      allow update: if isAdmin()
        || (isAdvisor()
          && resource.data.advisorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['discussionStatus', 'advisorResponse', 'respondedAt', 'respondedByUid', 'updatedAt']));
      allow create, delete: if false;
    }

    match /reportDownloads/{downloadId} {
      allow read: if isAdmin()
        || (isAdvisor() && resource.data.advisorUid == request.auth.uid)
        || (isInvestor() && resource.data.downloadedByUid == request.auth.uid);
      allow create, update, delete: if false;
    }


    match /investorDocuments/{documentId} {
      allow create: if isStaff()
        && request.resource.data.requestedByUid == request.auth.uid
        && (isAdmin() || (
          request.resource.data.advisorUid == request.auth.uid
          && advisorCanReferenceScope(request.resource.data)
        ));
      allow read: if isAdmin()
        || (isAdvisor() && resource.data.advisorUid == request.auth.uid)
        || (isInvestor() && resource.data.investorId == userDoc().data.investorId && resource.data.investorVisible == true);
      allow update: if isAdmin()
        || (
          isAdvisor()
          && resource.data.advisorUid == request.auth.uid
          && request.resource.data.get('investorId', null) == resource.data.get('investorId', null)
          && request.resource.data.get('advisorUid', null) == resource.data.get('advisorUid', null)
          && request.resource.data.get('requestedByUid', null) == resource.data.get('requestedByUid', null)
          && request.resource.data.get('investorUid', null) == resource.data.get('investorUid', null)
        )
        || (
          isInvestor()
          && resource.data.investorId == userDoc().data.investorId
          && resource.data.investorVisible == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'storagePath', 'fileName', 'mimeType', 'sizeBytes', 'status',
            'uploadedByUid', 'uploadedByRole', 'uploadedByName', 'uploadedAt',
            'verificationNote', 'verifiedAt', 'verifiedByUid', 'updatedAt'
          ])
          && request.resource.data.status == 'uploaded'
          && request.resource.data.uploadedByUid == request.auth.uid
          && request.resource.data.uploadedByRole == 'investor'
          && request.resource.data.storagePath is string
          && request.resource.data.storagePath.matches('^investor-documents/' + resource.data.investorId + '/' + documentId + '/[^/]+$')
        );
      allow delete: if isSuperAdmin();
    }

    match /clientServicingMaster/{documentId} {
      allow create: if isStaff() && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (request.resource.data.advisorUid == request.auth.uid && advisorCanReferenceScope(request.resource.data)));
      allow read: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid);
      allow update: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid && preservesAdvisorScope());
      allow delete: if isSuperAdmin();
    }

    match /clientQueries/{documentId} {
      allow create: if isStaff() && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (request.resource.data.advisorUid == request.auth.uid && advisorCanReferenceScope(request.resource.data)));
      allow read: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid);
      allow update: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid && preservesAdvisorScope());
      allow delete: if isSuperAdmin();
    }

    match /monthlyUpdateLogs/{documentId} {
      allow create: if isStaff() && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (request.resource.data.advisorUid == request.auth.uid && advisorCanReferenceScope(request.resource.data)));
      allow read: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid);
      allow update: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid && preservesAdvisorScope());
      allow delete: if isSuperAdmin();
    }

    match /quarterlyReviewLogs/{documentId} {
      allow create: if isStaff() && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (request.resource.data.advisorUid == request.auth.uid && advisorCanReferenceScope(request.resource.data)));
      allow read: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid);
      allow update: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid && preservesAdvisorScope());
      allow delete: if isSuperAdmin();
    }

    match /renewalTrackers/{documentId} {
      allow create: if isStaff() && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (request.resource.data.advisorUid == request.auth.uid && advisorCanReferenceScope(request.resource.data)));
      allow read: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid);
      allow update: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid && preservesAdvisorScope());
      allow delete: if isSuperAdmin();
    }

    match /deadlineMissLogs/{documentId} {
      allow create: if isStaff() && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (request.resource.data.advisorUid == request.auth.uid && advisorCanReferenceScope(request.resource.data)));
      allow read: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid);
      allow update: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid && preservesAdvisorScope());
      allow delete: if isSuperAdmin();
    }

    match /servicingChecklists/{documentId} {
      allow create: if isStaff() && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (request.resource.data.advisorUid == request.auth.uid && advisorCanReferenceScope(request.resource.data)));
      allow read: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid);
      allow update: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid && preservesAdvisorScope());
      allow delete: if isSuperAdmin();
    }

    // Birthday & Occasion Management is server-managed so family relationship
    // details and touchpoint history are never exposed through broad browser queries.
    match /investorOccasions/{occasionId} {
      allow read, create, update, delete: if false;
    }

    match /occasionTouchpoints/{touchpointId} {
      allow read, create, update, delete: if false;
    }

    // SIP funding schedules/cycles are server-managed. Investor and staff UI
    // access them through authenticated API routes so routing/audit fields cannot
    // be forged directly from the browser.
    match /sipFundingSchedules/{scheduleId} {
      allow read, create, update, delete: if false;
    }

    match /sipFundingCycles/{cycleId} {
      allow read, create, update, delete: if false;
    }

    // Portfolio data is written only by authenticated server APIs. Clients may read
    // records that belong to them (investors) or to their assigned book (staff).
    match /portfolioPositions/{positionId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /ulipPolicies/{policyId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /investmentTransactions/{transactionId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    // Manual Portfolio Management ledgers are server-written. Current holdings
    // continue to live in portfolioPositions; these collections preserve the
    // supporting account, cash, income, action, charge, allocation and
    // reconciliation history for manually managed portfolios.
    match /manualPortfolioAccounts/{accountId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /manualPortfolioAccountSnapshots/{snapshotId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /manualPortfolioCashLedger/{entryId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /manualPortfolioIncome/{incomeId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /manualPortfolioCorporateActions/{actionId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /manualPortfolioCharges/{chargeId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /manualPortfolioGoalAllocations/{allocationId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /manualPortfolioReconciliations/{reconciliationId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /manualPortfolioNotes/{noteId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data)
        || (investorOwnsRecord(resource.data) && resource.data.visibility == 'Investor');
      allow create, update, delete: if false;
    }

    match /portfolioSnapshots/{snapshotId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /portfolioSnapshotPositions/{snapshotPositionId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    // Broker account identity, daily broker snapshots and depository movements
    // are server-written. Delivery holdings still live in portfolioPositions;
    // these records preserve account-level provenance and DP reconciliation.
    match /brokerAccounts/{accountId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /brokerAccountSnapshots/{snapshotId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /brokerDpTransactions/{transactionId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /tradingTransactions/{transactionId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /tradingMonthlySummaries/{summaryId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data) || investorOwnsRecord(resource.data);
      allow create, update, delete: if false;
    }

    match /externalInvestorMappings/{mappingId} {
      allow read: if isAdmin() || ownsAdvisorRecord(resource.data);
      allow create, update, delete: if false;
    }

    // Full Aadhaar values, when configured, live only in this server-managed
    // encrypted collection. No browser client can read or write it.
    match /investorKycSecure/{investorId} {
      allow read, create, update, delete: if false;
    }

    match /portfolioImports/{importId} {
      allow read: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /portfolioImportFiles/{fileId} {
      allow read: if isAdmin() || (isAdvisor() && resource.data.advisorUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /portfolioFileFingerprints/{fingerprintId} {
      allow read, create, update, delete: if false;
    }

    match /portfolioImportMappingProfiles/{profileId} {
      // Generic import column mappings are server-managed. The browser uses
      // authenticated API routes so providers cannot expose internal mapping
      // rules or mutate another advisor's import profile directly.
      allow read, create, update, delete: if false;
    }

    match /portfolioImportChanges/{changeId} {
      allow read, create, update, delete: if false;
    }

    match /portfolioImportChangeItems/{changeItemId} {
      allow read, create, update, delete: if false;
    }

    match /dataImports/{importId} {
      allow create: if isStaff()
        && request.resource.data.createdByUid == request.auth.uid
        && (isAdmin() || (
          request.resource.data.advisorUid == request.auth.uid
          && advisorCanReferenceScope(request.resource.data)
        ));

      allow read: if isAdmin()
        || (isAdvisor() && resource.data.advisorUid == request.auth.uid);

      allow update: if isAdmin() || (
        isAdvisor()
        && resource.data.advisorUid == request.auth.uid
        && request.resource.data.get('advisorUid', null) == resource.data.get('advisorUid', null)
        && request.resource.data.get('investorId', null) == resource.data.get('investorId', null)
      );

      allow delete: if isSuperAdmin();
    }


    match /emailDeliveries/{deliveryId} {
      allow read: if isAdmin()
        || (isAdvisor() && resource.data.advisorUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /emailDeliveryEvents/{eventId} {
      allow read: if isAdmin()
        || (isAdvisor() && resource.data.advisorUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /marketCommentaries/{commentaryId} {
      allow read: if isStaff();

      allow create: if isStaff()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'draft';

      allow update: if isAdmin() || (
        isAdvisor()
        && resource.data.createdByUid == request.auth.uid
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && resource.data.status in ['draft', 'archived', 'approved']
        && request.resource.data.status in ['draft', 'archived']
      );

      allow delete: if isSuperAdmin();
    }

    match /marketCommentaries/{commentaryId}/versions/{versionId} {
      allow read: if isStaff();
      allow create: if isAdmin() || (
        isAdvisor()
        && request.resource.data.savedByUid == request.auth.uid
        && get(/databases/$(database)/documents/marketCommentaries/$(commentaryId)).data.createdByUid == request.auth.uid
      );
      allow update: if false;
      allow delete: if isSuperAdmin();
    }


    match /reportTemplates/{templateId} {
      allow read: if isAdmin()
        || (isAdvisor() && resource.data.status == 'active');
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }


    match /reportTemplates/{templateId}/versions/{versionId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /emailTemplates/{templateId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /emailTemplates/{templateId}/versions/{versionId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /brandingVersions/{versionId} {
      allow read, create: if isAdmin();
      allow update, delete: if isSuperAdmin();
    }

    match /reportSettings/{documentId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // Only the branding document is intentionally public. Keep all future
    // publicSettings documents private-by-default so configuration cannot be
    // accidentally exposed simply by adding a new document to this collection.
    match /publicSettings/branding {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /publicSettings/{documentId} {
      allow read, create, update, delete: if false;
    }

    match /investorPortalAccounts/{documentId} {
      allow read, write: if isAdmin();
    }
  }
}
