NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=<FIREBASE_WEB_API_KEY>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=growvest-reporttool.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=growvest-reporttool
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=growvest-reporttool.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=712836553685
NEXT_PUBLIC_FIREBASE_APP_ID=1:712836553685:web:ba223a54cd0a5987d1bb5c
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-0D3TE6B7SE
NEXT_PUBLIC_MICROSOFT_TENANT_ID=YOUR_MICROSOFT_DIRECTORY_TENANT_ID

# Firebase Admin SDK (server-side only)
FIREBASE_ADMIN_PROJECT_ID=growvest-reporttool
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="<FIREBASE_ADMIN_PRIVATE_KEY>\n"
FIREBASE_ADMIN_STORAGE_BUCKET=growvest-reporttool.firebasestorage.app

# Brevo SMTP (server-side only - never prefix with NEXT_PUBLIC_)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
# Brevo SMTP login shown under Brevo > SMTP & API > SMTP. This is often not the sender email.
BREVO_SMTP_USER=
# Use a newly generated SMTP key. Do not paste it into frontend code.
BREVO_SMTP_PASSWORD=
BREVO_DEFAULT_SENDER_NAME=GrowVest
BREVO_DEFAULT_SENDER_EMAIL=cwp@growvest.info
BREVO_REPLY_TO_EMAIL=cwp@growvest.info
# Set true only after each Advisor email is configured/verified as a Brevo sender.
BREVO_ALLOW_ADVISOR_SENDERS=false

# Scheduled reminder endpoint protection. This protects the endpoint; it does not schedule it.
CRON_SECRET=
