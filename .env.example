# Firebase Web SDK (public by design)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=growvest-reporttool
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG=false

# Application
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

# Server-only Firebase Admin credentials (omit on managed Google runtimes using ADC)
FIREBASE_ADMIN_PROJECT_ID=growvest-reporttool
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_STORAGE_BUCKET=

# Server security - generate unique random values for each environment
KYC_FIELD_ENCRYPTION_KEY=
KYC_FIELD_ENCRYPTION_KEY_VERSION=1
# Used by scheduled server jobs including /api/cron/birthday-reminders,
# /api/cron/meeting-reminders and /api/cron/sip-funding-reminders.
CRON_SECRET=
BREVO_WEBHOOK_TOKEN=
FIREBASE_APP_CHECK_ENFORCE_SERVER=false

# Email / Brevo
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_DEFAULT_SENDER_EMAIL=
BREVO_DEFAULT_SENDER_NAME=GrowVest
BREVO_REPLY_TO_EMAIL=
BREVO_ALLOW_ADVISOR_SENDERS=false

# Report delivery privacy controls. CC/BCC is limited to active staff plus these.
REPORT_DELIVERY_ALLOWED_EMAILS=
REPORT_DELIVERY_ALLOWED_DOMAINS=
