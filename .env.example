# Public Firebase web application configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_APP_URL=https://insights.growvest.info
NEXT_PUBLIC_MICROSOFT_TENANT_ID=

# Firebase App Check - reCAPTCHA Enterprise website key
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# Local development only. Never enable in production.
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG=false

# Firebase Admin / server credentials
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_STORAGE_BUCKET=

# Brevo SMTP and delivery tracking
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_DEFAULT_SENDER_NAME=GrowVest
BREVO_DEFAULT_SENDER_EMAIL=
BREVO_REPLY_TO_EMAIL=
BREVO_ALLOW_ADVISOR_SENDERS=false
BREVO_WEBHOOK_TOKEN=

# Scheduled jobs
CRON_SECRET=
