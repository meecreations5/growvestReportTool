rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && profile().data.status == 'active';
    }

    function isStaff() {
      return activeUser() && profile().data.role in ['super_admin', 'admin', 'advisor'];
    }

    function isInvestorFor(investorId) {
      return activeUser()
        && profile().data.role == 'investor'
        && profile().data.portalEnabled != false
        && profile().data.investorId == investorId;
    }

    function investorExists(investorId) {
      return firestore.exists(/databases/(default)/documents/investors/$(investorId));
    }

    function investorRecord(investorId) {
      return firestore.get(/databases/(default)/documents/investors/$(investorId));
    }

    function staffCanAccessInvestor(investorId) {
      return isStaff()
        && (
          profile().data.role in ['super_admin', 'admin']
          || (
            profile().data.role == 'advisor'
            && investorExists(investorId)
            && (
              investorRecord(investorId).data.assignedAdvisorUid == request.auth.uid
              || investorRecord(investorId).data.advisorUid == request.auth.uid
            )
          )
        );
    }

    match /branding/{assetType}/{fileName} {
      allow read: if true;
      allow write: if isStaff()
        && profile().data.role in ['super_admin', 'admin']
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp'];
      allow delete: if isStaff() && profile().data.role in ['super_admin', 'admin'];
    }


    match /branding-fonts/{assetType}/{fileName} {
      allow read: if true;
      allow write: if isStaff()
        && profile().data.role in ['super_admin', 'admin']
        && request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType in ['font/woff2', 'font/woff', 'application/font-woff'];
      allow delete: if isStaff() && profile().data.role in ['super_admin', 'admin'];
    }


    match /profile-images/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if activeUser()
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp'];
      allow delete: if activeUser() && request.auth.uid == uid;
    }

    match /staff-signatures/{uid}/{assetType}/{fileName} {
      allow read: if true;
      allow write: if isStaff()
        && (request.auth.uid == uid || profile().data.role in ['super_admin', 'admin'])
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp'];
      allow delete: if isStaff()
        && (request.auth.uid == uid || profile().data.role in ['super_admin', 'admin']);
    }

    match /investor-documents/{investorId}/{documentId}/{fileName} {
      allow read: if staffCanAccessInvestor(investorId) || isInvestorFor(investorId);

      // Staff may upload for investors they are authorised to service. Investor
      // uploads must carry server-verifiable ownership metadata and an Investor
      // may update only an object that was already uploaded by that same UID.
      allow create: if request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png']
        && (
          staffCanAccessInvestor(investorId)
          || (
            isInvestorFor(investorId)
            && request.resource.metadata.investorId == investorId
            && request.resource.metadata.documentId == documentId
            && request.resource.metadata.uploadedByUid == request.auth.uid
            && request.resource.metadata.uploadedByRole == 'investor'
          )
        );

      allow update: if request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png']
        && (
          staffCanAccessInvestor(investorId)
          || (
            isInvestorFor(investorId)
            && resource.metadata.investorId == investorId
            && resource.metadata.documentId == documentId
            && resource.metadata.uploadedByUid == request.auth.uid
            && resource.metadata.uploadedByRole == 'investor'
            && request.resource.metadata.investorId == investorId
            && request.resource.metadata.documentId == documentId
            && request.resource.metadata.uploadedByUid == request.auth.uid
            && request.resource.metadata.uploadedByRole == 'investor'
          )
        );

      allow delete: if staffCanAccessInvestor(investorId)
        || (
          isInvestorFor(investorId)
          && resource.metadata.investorId == investorId
          && resource.metadata.documentId == documentId
          && resource.metadata.uploadedByUid == request.auth.uid
          && resource.metadata.uploadedByRole == 'investor'
        );
    }

    // Monthly report PDFs are uploaded by Firebase Admin and downloaded only
    // through the authenticated server API. No direct client access is allowed.
    match /monthly-reports/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
